<!-- Build MultiTypeSpikeModel. Assumes beast2, BeastFX and BDMM-Prime are sibling checkouts,
     with BDMM-Prime already built; SA and BEASTLabs are downloaded into deps/. -->
<project basedir="." default="build_jar_all_mtsm" name="BUILD_MultiTypeSpikeModel">
	<description>
	    Build MultiTypeSpikeModel.
	    JUnit tests are available for this build.
	</description>

	<property environment="env" />

	<!-- set global properties for this build -->
	<property name="mtsmdir" value="." />
	<property name="srcmtsm" location="src" />
	<property name="docmtsm" location="doc" />
	<property name="examplesmtsm" location="examples" />
	<property name="fxtemplatesmtsm" location="fxtemplates" />
	<property name="libmtsm" location="lib" />
	<property name="buildmtsm" location="build" />
	<property name="distmtsm" location="${buildmtsm}/dist" />
	<property name="release_dir" value="release" />
	<property name="Add_on_dir" value="${release_dir}/add-on" />
	<property name="report" value="${buildmtsm}/junitreport" />

	<!-- Sibling package checkouts. Each of these
	     is expected to already be built, so its own build/ directory holds
	     compiled classes we can compile and test against. -->
	<property name="beast2path" location="../beast2" />
	<property name="libBeast2" location="${beast2path}/lib" />
	<property name="buildbeastmtsm" location="build-beast" />

	<property name="beastfxpath" location="../BeastFX" />
	<property name="buildbeastfxmtsm" location="build-beastfx" />

	<property name="bdmmprimepath" location="../BDMM-Prime" />
	<property name="bdmmprimeclasspath" location="${bdmmprimepath}/build" />

	<property name="depsmtsm" location="deps" />

	<path id="classpath">
		<pathelement path="${buildmtsm}" />
		<pathelement path="${buildbeastmtsm}" />
		<fileset dir="${libBeast2}" includes="**/*.jar" />
		<pathelement path="${buildbeastfxmtsm}" />
		<fileset dir="${beastfxpath}/locallib" includes="**/*.jar" erroronmissingdir="false" />
		<fileset dir="${env.JAVA_FX_HOME}" includes="**/*.jar" erroronmissingdir="false" />
		<pathelement path="${bdmmprimeclasspath}" />
		<fileset dir="${depsmtsm}/SA" includes="**/*.jar" erroronmissingdir="false" />
		<fileset dir="${depsmtsm}/BEASTLabs" includes="**/*.jar" erroronmissingdir="false" />
		<fileset dir="${libmtsm}" includes="**/*.jar" erroronmissingdir="false" />
	</path>

	<!-- compile beast2 and BeastFX from the sibling source checkouts, matching
	     BDMM-Prime's own build.xml (do not <import> beast2's build.xml - its
	     relative paths resolve against whichever project imports it, not
	     against beast2 itself). -->
	<target name="build-beastmtsm">
		<mkdir dir="${buildbeastmtsm}" />
		<javac srcdir="${beast2path}/src" destdir="${buildbeastmtsm}"
		       release="17" encoding="UTF-8" includeantruntime="false" fork="true">
			<classpath>
				<fileset dir="${libBeast2}" includes="**/*.jar" />
			</classpath>
		</javac>
	</target>

	<target name="build-beastfxmtsm" depends="build-beastmtsm">
		<mkdir dir="${buildbeastfxmtsm}" />
		<javac srcdir="${beastfxpath}/src" destdir="${buildbeastfxmtsm}"
		       release="17" encoding="UTF-8" includeantruntime="false" fork="true">
			<classpath>
				<fileset dir="${beastfxpath}/locallib" includes="**/*.jar" erroronmissingdir="false" />
				<fileset dir="${env.JAVA_FX_HOME}" includes="**/*.jar" erroronmissingdir="false" />
				<fileset dir="${libBeast2}" includes="**/*.jar" />
				<pathelement path="${buildbeastmtsm}" />
			</classpath>
		</javac>
	</target>

	<!-- fetch released SA and BEASTLabs jars via BEAST's own package manager -->
	<target name="install-dependenciesmtsm" depends="build-beastmtsm">
		<mkdir dir="${depsmtsm}" />
		<java fork="true" classname="beast.pkgmgmt.PackageManager">
			<jvmarg line="-Dbeast.user.package.dir=${depsmtsm}" />
			<arg line="-add SA" />
			<classpath>
				<pathelement path="${buildbeastmtsm}" />
			</classpath>
		</java>
		<java fork="true" classname="beast.pkgmgmt.PackageManager">
			<jvmarg line="-Dbeast.user.package.dir=${depsmtsm}" />
			<arg line="-add BEASTLabs" />
			<classpath>
				<pathelement path="${buildbeastmtsm}" />
			</classpath>
		</java>
	</target>


	<!-- start -->
	<target name="initmtsm">
		<echo message="${ant.project.name}: ${ant.file}" />

		<available file="${mtsmdir}/version.xml" property="versionAvailable" />
		<fail unless="versionAvailable">
			** Required file version.xml does not exist. **
		</fail>

		<xmlproperty file="${mtsmdir}/version.xml" prefix="fromVersionFile" />
		<property name="projName" value="${fromVersionFile.package(name)}" />
		<property name="mtsmversion" value="${fromVersionFile.package(version)}" />

		<fail message="Expected a local BDMM-Prime checkout at ${bdmmprimepath} - see the comment at the top of this file.">
			<condition>
				<not>
					<available file="${bdmmprimepath}" type="dir" />
				</not>
			</condition>
		</fail>
		<fail message="${bdmmprimeclasspath} does not exist yet - build BDMM-Prime first (run 'ant' in ${bdmmprimepath}).">
			<condition>
				<not>
					<available file="${bdmmprimeclasspath}" type="dir" />
				</not>
			</condition>
		</fail>
	</target>

	<target name="cleanmtsm">
		<delete dir="${buildmtsm}" />
		<delete dir="${buildbeastmtsm}" />
		<delete dir="${buildbeastfxmtsm}" />
		<delete dir="${depsmtsm}" />
	</target>

	<!-- clean previous build, compile Java source code, run JUnit tests -->
	<target name="build_all_mtsm" depends="cleanmtsm,compile-allmtsm,junitmtsm"
	        description="Clean and build, running unit tests">
	</target>

	<!-- clean previous build, compile, test, and produce the package jars -->
	<target name="build_jar_all_mtsm" depends="cleanmtsm,compile-allmtsm,junitmtsm,dist_all_mtsm"
	        description="Clean, build, test, and package">
	</target>

	<!-- same, but skip the JUnit tests -->
	<target name="build_jar_all_mtsm_NoJUnitTest" depends="cleanmtsm,compile-allmtsm,dist_all_mtsm"
	        description="Clean, build, and package without running tests">
	</target>

	<!-- compile Java source code (src/multitypespike/** and src/test/**) -->
	<target name="compile-allmtsm" depends="initmtsm,build-beastfxmtsm,install-dependenciesmtsm">

		<property name="myclasspath" refid="classpath" />
		<echo message="Classpath = ${myclasspath}" />

		<mkdir dir="${buildmtsm}" />

		<javac srcdir="${srcmtsm}" destdir="${buildmtsm}" classpathref="classpath"
		       fork="true"
		       includeantruntime="false"
		       encoding="UTF-8"
		       release="17">
			<include name="**/*.java" />
		</javac>
		<copy todir="${buildmtsm}">
			<fileset dir="${srcmtsm}" includes="**/*.properties,**/*.png" />
		</copy>
		<echo message="Successfully compiled." />
	</target>

	<!-- make the MultiTypeSpikeModel package jars -->
	<target name="dist_all_mtsm" depends="compile-allmtsm" description="create MultiTypeSpikeModel jars">
		<mkdir dir="${distmtsm}" />

		<jar jarfile="${distmtsm}/MultiTypeSpikeModel.package.jar">
			<manifest>
				<attribute name="Built-By" value="${user.name}" />
			</manifest>
			<fileset dir="${buildmtsm}">
				<include name="**/*.class" />
				<include name="**/*.properties" />
			</fileset>
		</jar>

		<jar jarfile="${distmtsm}/MultiTypeSpikeModel.src.jar">
			<fileset dir="${srcmtsm}">
				<include name="**/*.java" />
			</fileset>
		</jar>
	</target>

	<!-- P0GeValidation*.java have their own main(), not picked up here -->
	<target name="junitmtsm">
		<mkdir dir="${report}" />
		<junit printsummary="yes" failureproperty="testFailedmtsm">
			<classpath>
				<path refid="classpath" />
				<path location="${buildmtsm}" />
			</classpath>

			<formatter type="xml" />

			<batchtest fork="yes" todir="${report}">
				<fileset dir="${srcmtsm}">
					<include name="test/**/*Test.java" />
				</fileset>
			</batchtest>
		</junit>
		<fail if="testFailedmtsm" message="One or more MultiTypeSpikeModel unit tests failed. See ${report} for details." />
		<echo message="JUnit tests finished." />
	</target>

	<target name="junitreportmtsm">
		<junitreport todir="${report}">
			<fileset dir="${report}" includes="*.xml" />
			<report format="frames" todir="${report}" />
		</junitreport>
		<echo message="JUnit test report finished." />
	</target>


	<!-- Assemble the installable BEAST 2 add-on zip -->
	<target name="package"
	        depends="build_jar_all_mtsm_NoJUnitTest"
	        description="release BEAST 2 package version of MultiTypeSpikeModel">

		<delete dir="${Add_on_dir}" />
		<mkdir dir="${Add_on_dir}" />
		<mkdir dir="${Add_on_dir}/lib" />
		<mkdir dir="${Add_on_dir}/doc" />
		<mkdir dir="${Add_on_dir}/fxtemplates" />
		<mkdir dir="${Add_on_dir}/examples" />

		<copy todir="${Add_on_dir}">
			<fileset file="version.xml" />
		</copy>
		<mkdir dir="${examplesmtsm}" />
		<copy todir="${Add_on_dir}/examples">
			<fileset dir="${examplesmtsm}" includes="**/*.xml" erroronmissingdir="false" />
		</copy>
		<copy todir="${Add_on_dir}/fxtemplates">
			<fileset dir="${fxtemplatesmtsm}" includes="*.xml" />
		</copy>
		<mkdir dir="${docmtsm}" />
		<copy todir="${Add_on_dir}/doc">
			<fileset dir="${docmtsm}" includes="**/*" erroronmissingdir="false" />
		</copy>
		<copy todir="${Add_on_dir}/lib">
			<fileset dir="${distmtsm}" includes="MultiTypeSpikeModel.package.jar" />
		</copy>
		<copy todir="${Add_on_dir}">
			<fileset dir="${distmtsm}" includes="MultiTypeSpikeModel.src.jar" />
		</copy>

		<zip destfile="${distmtsm}/MultiTypeSpikeModel.package.v${mtsmversion}.zip">
			<fileset dir="${Add_on_dir}">
				<include name="**/*" />
			</fileset>
		</zip>
		<echo message="Package v${mtsmversion} release built at ${distmtsm}/MultiTypeSpikeModel.package.v${mtsmversion}.zip" />
	</target>


	<!-- Install into the local BEAST 2.7 package directory. -->
	<condition property="isWindows"><os family="windows" /></condition>
	<condition property="isLinux"><and><os family="unix" /><not><os family="mac" /></not></and></condition>
	<condition property="isMac"><os family="mac" /></condition>

	<target name="installLinux" depends="package" if="isLinux">
		<mkdir dir="${user.home}/.beast/2.7/${projName}" />
		<unzip src="${distmtsm}/MultiTypeSpikeModel.package.v${mtsmversion}.zip" dest="${user.home}/.beast/2.7/${projName}" />
		<!-- BEAUti caches the package class path; clear it so the new package and its templates are found -->
		<replaceregexp match="^package\.path=.*$" replace="" byline="true">
			<fileset dir="${user.home}/.beast/2.7" includes="beauti.properties" erroronmissingdir="false" />
		</replaceregexp>
	</target>

	<target name="installMac" depends="package" if="isMac">
		<mkdir dir="${user.home}/Library/Application Support/BEAST/2.7/${projName}" />
		<unzip src="${distmtsm}/MultiTypeSpikeModel.package.v${mtsmversion}.zip" dest="${user.home}/Library/Application Support/BEAST/2.7/${projName}" />
		<!-- BEAUti caches the package class path; clear it so the new package and its templates are found -->
		<replaceregexp match="^package\.path=.*$" replace="" byline="true">
			<fileset dir="${user.home}/Library/Application Support/BEAST/2.7" includes="beauti.properties" erroronmissingdir="false" />
		</replaceregexp>
	</target>

	<target name="installWindows" depends="package" if="isWindows">
		<mkdir dir="${user.home}/BEAST/2.7/${projName}" />
		<unzip src="${distmtsm}/MultiTypeSpikeModel.package.v${mtsmversion}.zip" dest="${user.home}/BEAST/2.7/${projName}" />
		<!-- BEAUti caches the package class path; clear it so the new package and its templates are found -->
		<replaceregexp match="^package\.path=.*$" replace="" byline="true">
			<fileset dir="${user.home}/BEAST/2.7" includes="beauti.properties" erroronmissingdir="false" />
		</replaceregexp>
	</target>

	<target name="install" depends="installWindows,installMac,installLinux"
	        description="Build and install into the local BEAST 2.7 package directory">
	</target>

</project>
